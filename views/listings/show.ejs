<% layout("/layouts/boilerplate") %>

<style>

@media (max-width: 768px) {

    .container {
        width: 100%;
        max-width: 100%;
        padding-left: 15px;
        padding-right: 15px;
    }

    /* Show listing card */
    .show-card {
        width: 100% !important;
        max-width: 100%;
        margin: 0 auto;
    }

    /* Listing image */
    .show-img {
        width: 100% !important;
        height: 300px;
        object-fit: cover;
        border-radius: 15px !important;
    }

    /* Buttons */
    .btns {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .btns .btn {
        margin: 0 !important;
    }

    /* Map */
    #map {
        width: 100% !important;
        max-width: 100%;
        height: 300px;
        margin: 20px 0 25px 0;
        border-radius: 12px;
    }

    /* Reviews */
    .review-container{
      margin-left: 4rem !important;
      margin-right: 2rem !important;
    }
    .review-card {
        width: 100%;
        margin-right: 1rem;
        margin-bottom: 15px;
    }

    .all-review-div{
      width: 100%;
     max-width: 600px;
     margin-right: 2rem;
     position: relative;
    right: 15px;
    border-radius: 1rem;
    }
}
</style>
<body>
  <div class="row mt-3">
  <div class="col-8 offset-3">
    <h2><%= result.title %> </h2>
  </div>
<div class="card col-6 offset-3 show-card listing-card">
  <img src="<%= result.img.url %>" class="card-img-top show-img" alt="Listing Img">
  <div class="card-body">
    <p class="card-text"> Owned By <%= result.owner.username %>  </p>
   
  <p>  <%= result.description %> </p>
  <p>   &#x20B9;<%= result.price ? result.price.toLocaleString("en-IN") : "N/A" %> <br></p>
  <p>  <%= result.location %></p>
  <p>  <%= result.country %></p>
  <p>
    Category:<%= result.category %>
</p>
   
  </div>
<% if (currentUser&&currentUser._id.equals(result.owner._id)) { %>
 <div class="btns mt-2">
<a href="/listings/<%= result._id %>/edit"><button class="btn btn-dark offset-3 add-btn">Edit </button></a>
   <form method="post" action="/listings/<%= result._id %>?_method=DELETE"> <button class="btn btn-dark offset-5">Delete </button></form>
  </div>
<% } %>


<!-- MAP -->

<div class="card col-lg-8 col-md-10 col-12 show-card">
  <div>

    <h3>Location</h3>
    <hr>

    <div
      id="map"
      data-latitude="<%= result.latitude %>"
      data-longitude="<%= result.longitude %>"
      data-location="<%= result.location %>"
    ></div>

  </div>
</div>

<!-- END MAP -->
  
</div>
 
<div class="col-8 offset-3 review-container">
  <% if (currentUser) { %>
    <h4>Leave a Review</h4>
    <form method="post" action="/listings/<%= result._id %>/reviews" novalidate class="needs-validation">
      <div class="mb-3 mt-3"> 
        <!-- <label for="rating" class="form-label"></label>
        <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range"> -->
        <legend>Rating:</legend>
<fieldset class="starability-slot">
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>
      </div>
      <div class="mb-3 mt-3">
        <label for="comment" class="form-label"> Comments</label>
        <textarea name="review[comment]" id="comment" rows="5" cols="50" class="form-control" required></textarea>
        <div class="invalid-feedback">Please Add Some Comments For Review</div>

      </div>
      <button class="btn btn-outline-dark">Submit</button>
    </form>
    <br>
      <hr>
       <% } %>



      
<!-- start -->
 <% if (result.reviews.length>0) { %>
  
 
      <div class="row mb-3 review-card">
        <p><b>All Reviews</b></p>
<% for(review of result.reviews){ %>
    <div class="card col-5 ms-3 mt-3 all-review-div" >
    <div class="card-body">

      <h5 class="card-title"> @<%= review.author.username %></h5>
      <p class="starability-result card-text" data-rating="<%=review.rating %>"></p>
      <p class="card-text"><%=review.comment %></p>
       
    </div>
    <% if (currentUser) { %>
    <form class="mb-3" method="post" action="/listings/<%=result._id %>/reviews/<%= review._id %>?_method=DELETE">
      <button class="btn btn-sm btn-dark"> Delete Review</button>
    </form>  <% } %>
    </div>
    <% } %>
    </div>
    <% } %>
    <!-- end -->
  </div>
 
</div>   
</body>
