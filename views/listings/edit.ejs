<% layout("/layouts/boilerplate") %>

    <body>
        <div class=" mt-3">
            <div class="row">
                <div class="col-8 offset-2">
                    <br><br>
                    <h2 class="mb-4">Edit Listing </h2>
                    
                    
                    
                    <form method="post" action="/listings/<%= oldData._id %>?_method=PUT" novalidate
                        class="needs-validation" enctype="multipart/form-data">


                        <div class="mb-3">
                            <label for="title" class="form-label">Title</label>
                            <input required type="text" class="form-control" id="title" name="listing[title]"
                                value="<%= oldData.title %>">

                            <div class="invalid-feedback">Fill Title field</div>

                        </div>

                        <div class="mb-3">
                            <label for="description" class="form-label">Description</label>
                            <textarea class="form-control" id="description" name="listing[description]"
                                required> <%= oldData.description %></textarea>
                            <div class="invalid-feedback">Please Enter Information About this Place</div>

                        </div>

                        <div class="mb-3">
                            <label for="img" class="form-label">Original Image</label><br>
                            <img src="<%= originalUrl %>" alt="an image of listing" class="original-edit-img">

                        </div>

                        <div class="mb-3">
                            <label for="img" class="form-label"> New Image </label>
                            <input type="file" class="form-control" id="img" name="listing[img]" 
                        </div>


                 <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">Price</label>
                        <input type="number" class="form-control" id="price" name="listing[price]"
                       value="<%= oldData.price %>" required>
                    <div class="invalid-feedback">Enter valid Price </div>

                </div>

                         <div class="mb-3 col-md-8">
                            <label for="country" class="form-label">Country</label>
                            <input type="text" class="form-control" id="country" name="listing[country]"
                            value="<%= oldData.country %>" required>
                         <div class="invalid-feedback">Fill Country name</div>

                     </div>

                </div>

                        <div class="mb-3">
                             <label for="location" class="form-label">Location</label>
                            <input type="text" class="form-control" id="location" name="listing[location]"
                            value="<%= oldData.location %>" required>
                        <div class="invalid-feedback">Enter Location</div>
                 </div>

              <div class="mb-3">
       <label for="country" class="form-label">Category</label>

    <select
        name="listing[category]"
        id="category"
        class="form-select"
        a
        required
    >
        <option value="<%= oldData.category %>"></option>
        <option value="Trending">Trending</option>
        <option value="Rooms">Rooms</option>
        <option value="Iconic Cities">Iconic Cities</option>
        <option value="Mountains">Mountains</option>
        <option value="Castles">Castles</option>
         <option value="Amazing">Amazing Pools</option>
        <option value="Pools">Pools</option>
        <option value="camping">camping</option>
        <option value="Farms">Farms</option>
        <option value="Arctic">Arctic</option>
    </select>
</div>
    <br>
                    <button type="submit" class="btn btn-dark add-btn mt-3 mb-2">Update</button>
                </form>
             </div>
         </div>

        </div>
    </body>